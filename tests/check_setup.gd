extends SceneTree
## Headless boundary checks against snapshots generated by the TypeScript engine.

const Catalog = preload("res://content/setup_catalog.gd")
const Setup = preload("res://gameplay/run_setup.gd")
const Random = preload("res://gameplay/run_random.gd")
const Snapshot = preload("res://tests/state_snapshot.gd")

var failures: int = 0
var comparisons: int = 0


func _initialize() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	if args.size() != 1:
		printerr("Use node tests/check-setup.cjs to generate reference inputs.")
		quit(1)
		return
	var reference: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(args[0]))
	var loaded := Catalog.load_directory()
	_check(loaded.errors.is_empty(), "Authored setup content loads: %s" % [loaded.errors])
	for scenario: Dictionary in reference.scenarios:
		var catalog := Catalog.from_data(scenario.data)
		_check(catalog.errors.is_empty(), "%s validation: %s" % [scenario.name, catalog.errors])
		if not catalog.errors.is_empty():
			continue
		for case: Dictionary in scenario.cases:
			var state := Setup.create(catalog, int(case.seed))
			var actual: Dictionary = _snapshot(state)
			var differences: Array[String] = Snapshot.differences(actual, case.expected)
			_check(differences.is_empty(), "%s seed %.0f: mismatched fields %s" % [scenario.name, case.seed, differences])
			comparisons += 1
	for case: Dictionary in reference.invalid:
		var catalog := Catalog.from_data(case.data)
		_check(not catalog.errors.is_empty(), "Reject %s" % case.name)
	_check(not Catalog.load_directory(reference.badDirectory).errors.is_empty(), "Reject malformed JSON")
	_check(not Catalog.load_directory(reference.badDirectory.path_join("missing")).errors.is_empty(), "Reject missing files")
	for case: Dictionary in reference.randomCases:
		var random := Random.new(int(case.seed))
		for value: Dictionary in case.values:
			var roll: float = random.roll()
			# JSON decimal parsing may differ by one float ULP; integer seeds are exact.
			_check(random.seed == int(value.seed) and absf(roll - float(value.roll)) < 1e-15, "LCG overflow/roll parity")
	if loaded.errors.is_empty():
		_check_copy_isolation(loaded)
	if failures == 0:
		print("Setup checks passed: %d initial states, %d invalid catalogs, 1200 RNG rolls, file errors and copy isolation." % [comparisons, reference.invalid.size()])
	quit(0 if failures == 0 else 1)


func _check_copy_isolation(catalog: SetupCatalog) -> void:
	var first := Setup.create(catalog, 42)
	var second := Setup.create(catalog, 42)
	var baseline: Dictionary = _snapshot(second)
	first.hand[0].held_turns = 99
	first.weather.wet = 3
	first.cells[0].construct = {"test": true}
	first.reward_offers[0].habitatId = "changed"
	first.random.roll()
	_check(_snapshot(second) == baseline, "Runs own independent mutable state")
	for card: CardInstance in first.deck:
		if card.instance_id == first.hand[0].instance_id:
			_check(card != first.hand[0] and card.held_turns == 0, "Metadata and live copies are distinct")
	var prior_seed: int = first.random.seed
	_check(first.random.shuffled([]).is_empty(), "Empty shuffle")
	_check(first.random.shuffled([1]) == [1], "Singleton shuffle")
	_check(first.random.seed == prior_seed, "Empty/singleton shuffle consumes no RNG")
	var source: Array = [1, 2, 3, 4]
	first.random.shuffled(source)
	_check(source == [1, 2, 3, 4], "Shuffle does not mutate source")
	var a := Setup.create(catalog, 42)
	var b := Setup.create(catalog, 42)
	_check(_snapshot(a) == _snapshot(b), "Catalog can be reused without state leakage")


func _snapshot(state: RunState) -> Dictionary:
	return Snapshot.capture(state)


func _check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1
		printerr(message)
